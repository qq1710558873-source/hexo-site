<div class="fixed-userinfo border-radius-12">
  <div class="userinfo-bg"></div>
  <div class="content">
    <div class="avatar-wrapper">
      <div class="avatar">
        <picture>
          <source
            srcset="https://cdn.jsdelivr.net/gh/qq1710558873-source/cdn/image/avatar.webp"
            type="image/webp"
          />
          <img src="/images/avatar.png" alt="<%= config.author %>" width="200" height="200" />
        </picture>
      </div>
    </div>
    <div class="info">
      <div class="author"><%= config.author %></div>
      <div class="signature"><%= config.signature || '记录生活，分享技术' %></div>
    </div>
    <div class="stats">
      <a href="/archives" class="stat-item">
        <span class="stat-num"><%= site.posts.length %></span>
        <span class="stat-label">文章</span>
      </a>
      <a href="/tags" class="stat-item">
        <span class="stat-num"><%= site.tags.length %></span>
        <span class="stat-label">标签</span>
      </a>
      <a href="/categories" class="stat-item">
        <span class="stat-num"><%= site.categories.length %></span>
        <span class="stat-label">分类</span>
      </a>
    </div>
